# Copie este arquivo para ".env" e preencha com valores reais.
# O docker-compose.yml lê o arquivo ".env" automaticamente.

# ----- MySQL -----
MYSQL_ROOT_PASSWORD=troque-esta-senha

# ----- JWT (precisa ser IGUAL nos 3 serviços) -----
JWT_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
JWT_EXPIRATION=900000

# ----- E-mail (2FA por e-mail, usado pelo user-ms) -----
EMAIL_USERNAME=seu-email@gmail.com
EMAIL_PASSWORD=senha-de-app-do-gmail

# ----- OAuth2 Google (usado pelo user-ms) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- OAuth2 GitHub (usado pelo user-ms) -----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
