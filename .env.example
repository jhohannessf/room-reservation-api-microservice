# Copie este arquivo para ".env" e preencha com valores reais.
# O docker-compose.yml lê o arquivo ".env" automaticamente.

# ----- MySQL -----
MYSQL_ROOT_PASSWORD=troque-esta-senha

# ----- JWT (precisa ser IGUAL em user-ms, room-ms e booking-ms) -----
JWT_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
JWT_EXPIRATION=900000

# ----- E-mail (2FA por e-mail, usado pelo user-ms) -----
EMAIL_USERNAME=seu-email@gmail.com
EMAIL_PASSWORD=senha-de-app-do-gmail

# ----- OAuth2 Google (usado pelo user-ms) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- OAuth2 GitHub (usado pelo user-ms) -----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ----- RabbitMQ (usado por room-ms e booking-ms) -----
# Credenciais do broker — usadas tanto pelo container do RabbitMQ quanto pelos
# microsserviços que se conectam a ele (o host já é fixado como "rabbitmq" no
# docker-compose.yml, não precisa declarar aqui).
RABBITMQ_DEFAULT_USER=insira-um-usuario
RABBITMQ_DEFAULT_PASS=insira-uma-senha

# ----- Kafka (usado por room-ms e booking-ms) -----
# No Docker Compose, o endereço do broker já é fixado como "kafka:9092" direto
# no docker-compose.yml — não precisa preencher esta variável para rodar via Compose.
# Preencha apenas se for rodar algum serviço manualmente (fora do Docker), apontando
# para "localhost:29092" (porta exposta ao host) ou para o broker que você estiver usando.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
